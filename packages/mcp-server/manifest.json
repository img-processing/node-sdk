{
  "dxt_version": "0.1",
  "name": "img-processing-mcp",
  "version": "2.5.1",
  "description": "The official MCP Server for the Img Processing API",
  "author": {
    "name": "Img Processing",
    "email": "support@img-processing.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/img-processing/node-sdk.git"
  },
  "homepage": "https://github.com/img-processing/node-sdk/tree/main/packages/mcp-server#readme",
  "documentation": "https://docs.img-processing.com",
  "server": {
    "type": "node",
    "entry_point": "${__dirname}/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "IMG_PROCESSING_API_KEY": "${user_config.IMG_PROCESSING_API_KEY}"
      }
    }
  },
  "user_config": {
    "IMG_PROCESSING_API_KEY": {
      "title": "api_key",
      "description": "API Key for authentication",
      "required": true,
      "type": "string"
    }
  },
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
